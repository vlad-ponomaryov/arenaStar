# Server (.NET, outside Unity): keep our project files, ignore build output (Server-Spec 5.2)
!Server/**/*.csproj
Server/**/bin/
Server/**/obj/

# Playwright MCP scratch output (snapshots, console logs)
.playwright-mcp/
__pycache__/
