<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dedicated server host (Server-Spec §5). Without the .NET SDK, Tools/server-build.ps1 builds the same sources in bootstrap mode. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Arena.Server</RootNamespace>
    <AssemblyName>Arena.Server</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arena.Shared\Arena.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Content pack exported by the editor (Server-Spec 5.4); the server loads it next to its dll and re-checks the hash. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\Assets\_Project\Data\Net\ArenaContent.bytes" Link="ArenaContent.bytes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
